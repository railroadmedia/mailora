{
  "name": "railroad/mailora",
  "type": "library",
  "description": "Wrapper for Laravel's email functionality that adds HTTP API and front-end-dev-friendly view-creation and use.",
  "keywords": [
    "email",
    "mail",
    "laravel",
    "api",
    "wrapper"
  ],
  "homepage": "https://github.com/railroad/mailora",
  "license": "MIT",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "doctrine/dbal": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\Mailora\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Mailora\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Railroad\\Mailora\\Providers\\MailoraServiceProvider"
      ]
    }
  }
}